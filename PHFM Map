local TeleportService = game:GetService("TeleportService")
local player = game.Players.LocalPlayer

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
   Name = "🔥 Protect House From Monsters - MAPS 🔥",
   LoadingTitle = "Loading...",
   LoadingSubtitle = "byDevDrigo",
   ConfigurationSaving = { Enabled = false }
})

local Tab = Window:CreateTab("Teleportes Principais", 4483362458)

-- Função segura de teleporte
local function teleportTo(placeId)
    if placeId == 0 then
        Rayfield:Notify({
           Title = "ID Faltando!",
           Content = "Este botão está sem ID configurado.",
           Duration = 3,
           Image = 4483362458,
        })
        return
    end

    Rayfield:Notify({
       Title = "Teleportando...",
       Content = "Indo para o Place ID: " .. tostring(placeId),
       Duration = 3,
       Image = 4483362458,
    })
    task.wait(0.5)
    TeleportService:Teleport(placeId, player)
end

